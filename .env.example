# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fx_alphalab
DB_USER=postgres
DB_PASSWORD=your_password_here

# API Keys
FRED_API_KEY=your_fred_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud BigQuery (for GDELT news collector)
# Option 1: Store in project credentials/ directory (gitignored)
GOOGLE_APPLICATION_CREDENTIALS=credentials/gcloud-service-account.json
# Option 2: Store outside project directory
# GOOGLE_APPLICATION_CREDENTIALS=C:\Users\YourName\.gcloud\fx-alphalab-credentials.json

# MetaTrader5 Configuration
MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_mt5_server

# Data Collection Settings
SCRAPING_DELAY=3.0
REQUEST_TIMEOUT=30


# Resend email (https://resend.com — free tier: 3,000 emails/month, no credit card)
# 1. Sign up at resend.com
# 2. Create an API key
# 3. For dev: use EMAIL_FROM=FX-AlphaLab <onboarding@resend.dev> (sends to your Resend account email only)
# 4. For prod: verify your domain at resend.com and use your domain address
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=FX-AlphaLab <onboarding@resend.dev>

# Frontend URL — used to build links in emails
FRONTEND_URL=http://localhost:3000

# Dev-only tier bypass — set to true to allow upgrading tier without payment
DEV_TIER_BYPASS=false
